{
  "name": "warm-memory",
  "version": "0.7.5",
  "license": "Apache-2.0",
  "author": "WritersLogic, Inc. <david@writerslogic.com>",
  "description": "WARM (WritersLogic Adaptive Retention & Memory): local document search (BM25 + embedding cosine) and vector-symbolic associative memory, with prebuilt binaries for eight platforms in one package.",
  "repository": {
    "type": "git",
    "url": "https://github.com/writerslogic/warm"
  },
  "homepage": "https://writerslogic.com/warm",
  "keywords": [
    "vector-database",
    "semantic-search",
    "embeddings",
    "knowledge-graph",
    "rag",
    "local-first",
    "privacy",
    "hyperdimensional-computing",
    "associative-memory",
    "rust",
    "napi",
    "analogical-reasoning",
    "hopfield-network",
    "neuro-symbolic"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./semantic": {
      "types": "./semantic.d.ts",
      "require": "./semantic.js",
      "import": "./semantic.js"
    },
    "./memory": {
      "types": "./memory.d.ts",
      "require": "./memory.js",
      "import": "./memory.js"
    },
    "./vectra": {
      "types": "./vectra.d.ts",
      "require": "./vectra.js",
      "import": "./vectra.js"
    }
  },
  "types": "index.d.ts",
  "napi": {
    "binaryName": "writerslogic-warm",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "node scripts/build-node.cjs --release --features node-api,security",
    "build:debug": "node scripts/build-node.cjs --features node-api,security",
    "build:platform": "node scripts/build-node.cjs --platform --no-js --release --features node-api,security",
    "artifacts": "napi artifacts",
    "version": "napi version",
    "test": "node --test tests/node/*.test.cjs",
    "test:package": "node scripts/test-package.cjs",
    "test:types": "tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --types node tests/node/types.test.mts tests/node/memory-types.test.mts tests/node/vector-record-types.test.mts tests/node/vectra-types.test.mts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.8.1 || ^4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "semantic.js",
    "semantic.d.ts",
    "memory.js",
    "memory.d.ts",
    "vectra.js",
    "vectra.d.ts",
    "vectra-selector.js",
    "*.node",
    "README.md",
    "LICENSE",
    "docs/concepts.md",
    "docs/quickstart.md"
  ]
}
