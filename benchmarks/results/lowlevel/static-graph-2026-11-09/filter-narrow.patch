+
+/// Four query dot products with the same overflow handling as [`dot_i8_query`].
+#[must_use]
+#[inline(always)]
+pub(crate) fn dot_i8_query_x4(a: &[i8], rows: [&[i8]; 4], qsum: i32) -> [i64; 4] {
+    if a.len() > I8_DOT_MAX_DIMENSIONS {
+        rows.map(|row| dot_i8_long(a, row))
+    } else {
+        dot_i8_query_x4_bounded(a, rows, qsum).map(i64::from)
     }
