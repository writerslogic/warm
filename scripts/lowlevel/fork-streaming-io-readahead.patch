+def _runbook_insert_ranges():
+    """Insert ranges of the runbook named by --runbook_path in argv, in order ([] when absent)."""
+    try:
+        path = sys.argv[sys.argv.index("--runbook_path") + 1]
+        with open(path) as f:
+            text = f.read()
+    except (ValueError, IndexError, OSError):
+        return []
+    return [(int(a), int(b)) for a, b in
+            re.findall(r"operation:\s*'insert'\s+start:\s*(\d+)\s+end:\s*(\d+)", text)]
+
+
+class _ReadAhead:
+    """Loads the next insert ranges into the page cache from a background thread, so the timed
+    steps find them cached. Order and content of the data are unchanged; the thread only reads
+    the source file ahead of the runner and never hands data over."""
+
+    def __init__(self, filename, rows, dim, ranges, depth=4):
+        self.filename, self.dim, self.ranges, self.depth = filename, dim, ranges, depth
+        self.done, self.cond = 0, threading.Condition()
+        threading.Thread(target=self._run, daemon=True).start()
+
+    def consumed(self, start, end):
+        with self.cond:
+            while self.done < len(self.ranges) and self.ranges[self.done] != (start, end):
+                self.done += 1
+            self.done += 1
+            self.cond.notify()
+
+    def _run(self):
+        fd = os.open(self.filename, os.O_RDONLY)
+        try:
+            for i, (s, e) in enumerate(self.ranges):
+                with self.cond:
+                    while i >= self.done + self.depth:
+                        self.cond.wait()
+                off, n = 8 + s * self.dim * 4, (e - s) * self.dim * 4
+                os.posix_fadvise(fd, off, n, os.POSIX_FADV_WILLNEED)
+                os.pread(fd, n, off)
+        finally:
+            os.close(fd)
+
+
 class _RangeReader:
