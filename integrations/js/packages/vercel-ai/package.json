{
  "name": "warm-vercel-ai",
  "version": "0.1.0",
  "description": "Vercel AI SDK memory tools and retrieval middleware backed by WARM",
  "keywords": [
    "warm",
    "writerslogic",
    "vercel-ai",
    "ai-sdk",
    "agent-memory"
  ],
  "license": "Apache-2.0",
  "author": "WritersLogic, Inc. <david@writerslogic.com>",
  "homepage": "https://github.com/writerslogic/warm/blob/main/docs/integrations.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writerslogic/warm.git",
    "directory": "integrations/js/packages/vercel-ai"
  },
  "bugs": {
    "url": "https://github.com/writerslogic/warm/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "tsup && node --test test/*.test.mjs"
  },
  "dependencies": {
    "warm-core": "^0.1.0"
  },
  "peerDependencies": {
    "ai": ">=7.0.0 <8",
    "zod": "^3.25.76 || ^4"
  },
  "devDependencies": {
    "ai": "7.0.146",
    "zod": "^4.1.8"
  }
}
