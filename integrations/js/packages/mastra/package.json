{
  "name": "@writerslogic/warm-mastra",
  "version": "0.1.0",
  "description": "Mastra vector store backed by WARM",
  "keywords": [
    "warm",
    "writerslogic",
    "mastra",
    "vector-store",
    "agent-memory"
  ],
  "license": "Apache-2.0",
  "author": "WritersLogic, Inc. <david@writerslogic.com>",
  "homepage": "https://github.com/writerslogic/warm/blob/main/docs/integrations/frameworks/mastra.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writerslogic/warm.git",
    "directory": "integrations/js/packages/mastra"
  },
  "bugs": {
    "url": "https://github.com/writerslogic/warm/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "tsup && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@writerslogic/warm-core": "^0.1.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.78.0 <2"
  },
  "devDependencies": {
    "@mastra/core": "1.78.0",
    "@mastra/libsql": "1.26.2",
    "@mastra/memory": "1.38.0",
    "zod": "^4.1.8"
  }
}
