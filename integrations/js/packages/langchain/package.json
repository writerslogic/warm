{
  "name": "warm-langchain",
  "version": "0.1.0",
  "description": "LangChain.js VectorStore, retriever and chat message history backed by WARM",
  "keywords": [
    "warm",
    "writerslogic",
    "langchain",
    "vector-store",
    "retriever",
    "agent-memory"
  ],
  "license": "Apache-2.0",
  "author": "WritersLogic, Inc. <david@writerslogic.com>",
  "homepage": "https://github.com/writerslogic/warm/blob/main/docs/integrations.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writerslogic/warm.git",
    "directory": "integrations/js/packages/langchain"
  },
  "bugs": {
    "url": "https://github.com/writerslogic/warm/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsup && node --test test/*.test.mjs"
  },
  "dependencies": {
    "warm-core": "^0.1.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.2.19 <2"
  },
  "devDependencies": {
    "@langchain/core": "1.2.19"
  }
}
